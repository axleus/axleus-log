{
    "name": "axleus/axleus-log",
    "description": "Axleus Logging component",
    "license": "BSD-3-Clause",
    "keywords": [
        "axleus",
        "laminas-db",
        "mezzio",
        "laminas",
        "psr 3",
        "monolog"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net"
        }
    ],
    "homepage": "https://github.com/orgs/axleus/discussions",
    "support": {
        "issues": "https://github.com/axleus/axleus-log/issues",
        "chat": "https://discord.gg/9TxQ74EPsG"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0-dev",
        "laminas/laminas-hydrator": "^4.15.0",
        "laminas/laminas-component-installer": "^3.2",
        "monolog/monolog": "^3.4",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-i18n": "^2.22",
        "laminas/laminas-servicemanager": "^3.23.0 || ^4.0.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0.0",
        "phly/phly-event-dispatcher": "^1.5.0",
        "roave/security-advisories": "dev-master",
        "webware/coding-standard": "^0.1.0"
    },
    "extra": {
        "laminas": {
            "component": "Axleus\\Log",
            "config-provider": "Axleus\\Log\\ConfigProvider"
        }
    },
    "autoload": {
        "psr-4": {
            "Axleus\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AxleusTest\\Log\\": "test/unit/",
            "AxleusTestIntegration\\Log\\": "test/integration/"
        }
    },
    "scripts": {
        "check-all": [
            "@cs-check",
            "@sa",
            "@test",
            "@test-integration"
        ],
        "cs-check": "vendor/bin/php-cs-fixer check -v --show-progress=dots --stop-on-violation",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "sa": "vendor/bin/phpstan analyse --memory-limit=256M",
        "sa-gen-baseline": "vendor/bin/phpstan analyse --memory-limit=256M --generate-baseline",
        "sa-verbose": "vendor/bin/phpstan analyse --memory-limit=256M -vv",
        "upload-coverage": "coveralls -v"
    }
}
